# skhd 快捷鍵配置
# 官方文檔：https://github.com/koekeishiya/skhd
#
# 快捷鍵語法規則：
#   hotkey = <mode> '<' <action> | <action>
#   keysym = <mod> '-' <key> | <key>
#   使用 ';' 分隔多個命令
#   使用 '->' 表示按鍵不被 skhd 消費
#
# 完整修飾鍵列表：https://github.com/asmvik/skhd/issues/1
# 支持：fn, cmd, lcmd, rcmd, shift, lshift, rshift, alt, lalt, ralt,
#        ctrl, lctrl, rctrl, hyper, meh

# ============================================================
# 默認模式（可選）
# 使用 :: default 可以為默認模式定義 on_enter 命令
# 當前保持註釋狀態
# ============================================================

# :: default : yabai -m config active_window_border_color 0xff775759

# ============================================================
# 切換到指定工作區
# ============================================================

cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6
cmd - 7 : yabai -m space --focus 7
cmd - 8 : yabai -m space --focus 8
cmd - 9 : yabai -m space --focus 9
cmd - 0 : yabai -m space --focus 10

# ============================================================
# 將當前視窗移動到指定工作區
# ============================================================

cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7
cmd + shift - 8 : yabai -m window --space 8
cmd + shift - 9 : yabai -m window --space 9
cmd + shift - 0 : yabai -m window --space 10

# ============================================================
# 窗口焦點切換（社區推薦）
# 按方向切換當前聚焦的窗口
# ============================================================

cmd - h : yabai -m window --focus west
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - l : yabai -m window --focus east

# ============================================================
# 窗口移動（社區推薦）
# 將當前窗口按方向移動
# ============================================================

cmd + shift - h : yabai -m window --warp west
cmd + shift - j : yabai -m window --warp south
cmd + shift - k : yabai -m window --warp north
cmd + shift - l : yabai -m window --warp east

# ============================================================
# 切換布局（社區推薦）
# bsp：二叉空間分割（默認平鋪）
# stack：堆疊模式
# float：浮動模式
# ============================================================

cmd - slash : yabai -m config layout bsp
cmd - comma : yabai -m config layout float

# ============================================================
# 窗口大小調整（社區推薦）
# 使用 --resize 調整當前窗口大小
# bottom_right:dx:dy 表示調整右下角，正數擴大，負數縮小
# ============================================================

cmd - minus : yabai -m window --resize bottom_right:-50:-50
cmd - equal : yabai -m window --resize bottom_right:50:50

# ============================================================
# 全屏切換（社區推薦）
# ============================================================

cmd + shift - f : yabai -m window --toggle zoom-fullscreen

# ============================================================
# 浮動 / 平鋪切換（社區推薦）
# ============================================================

cmd + shift - space : yabai -m window --toggle float

# ============================================================
# 打開應用
# ============================================================

# 打開主力終端 Ghostty
cmd - return : open -a /Applications/Ghostty.app

# 打開 qutebrowser
cmd + shift - return : ~/Scripts/qtb.sh

# 打開 mpv
cmd - m : open -na /Applications/mpv.app $(pbpaste)

# ============================================================
# 應用特定綁定（社區推薦，可選）
# 語法：<mod> - <key> [ "app_name" : command ; * : command ]
# "app_name" 為空時表示不限應用
# ~ 表示不綁定，將按鍵傳遞給應用
