{
    "proxy": "",
    "edit_predictions": {
        "provider": "zed",
    },
    "cli_default_open_behavior": "new_window",
    "$schema": "zed://schemas/settings",

    "base_keymap": "Zed",
    "vim_mode": true,

    "theme": {
        "mode": "light",
        "light": "HUANG One Light Glass",
        "dark": "One Dark",
    },

    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Zed (Default)",
    },

    "ui_font_family": "STKaiti",
    "ui_font_size": 15,

    "buffer_font_family": "LXGW WenKai Mono GB",
    "buffer_font_size": 16,
    "buffer_font_features": {
        "calt": false,
    },
    "buffer_line_height": "comfortable",

    "agent_ui_font_family": "LXGW WenKai Mono GB",
    "agent_ui_font_size": 15,
    "agent_buffer_font_family": "LXGW WenKai Mono GB",
    "agent_buffer_font_size": 15,

    "tab_size": 4,
    "hard_tabs": false,
    "auto_indent": "syntax_aware",
    "auto_indent_on_paste": true,
    "preferred_line_length": 120,
    "soft_wrap": "none",
    "show_whitespaces": "selection",
    "ensure_final_newline_on_save": true,
    "remove_trailing_whitespace_on_save": true,
    "line_ending": "prefer_lf",
    "use_autoclose": true,
    "use_auto_surround": true,

    "autosave": {
        "after_delay": {
            "milliseconds": 1000,
        },
    },

    "minimum_contrast_for_highlights": 60,

    "format_on_save": "on",

    "auto_signature_help": true,
    "show_signature_help_after_edits": true,

    "semantic_tokens": "combined",

    "global_lsp_settings": {
        "semantic_token_rules": [
            {
                "token_type": "namespace",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "class",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "struct",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "enum",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "interface",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "type",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "typeParameter",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "function",
                "foreground_color": "#89B4FA"
            },
            {
                "token_type": "method",
                "foreground_color": "#89B4FA"
            },
            {
                "token_type": "macro",
                "foreground_color": "#F5C2E7"
            },
            {
                "token_type": "parameter",
                "foreground_color": "#FFFFFF"
            },
            {
                "token_type": "variable",
                "foreground_color": "#FFFFFF"
            },
            {
                "token_type": "property",
                "foreground_color": "#F38BA8"
            },
            {
                "token_type": "enumMember",
                "foreground_color": "#6BD7CA"
            },
            {
                "token_type": "keyword",
                "foreground_color": "#F5C2E7"
            },
            {
                "token_type": "number",
                "foreground_color": "#F9E2AF"
            },
            {
                "token_type": "string",
                "foreground_color": "#A6E3A1"
            },
            {
                "token_type": "regexp",
                "foreground_color": "#EBD391"
            },
            {
                "token_type": "operator",
                "foreground_color": "#94E2D5"
            },
            {
                "token_type": "modifier",
                "foreground_color": "#F5C2E7"
            }
        ]
    },

    "diagnostics": {
        "inline": {
            "enabled": true,
            "padding": 4,
            "max_severity": "warning",
        },
    },

    "project_panel": {
        "button": true,
        "default_width": 260,
        "dock": "right",
        "entry_spacing": "comfortable",
        "file_icons": true,
        "folder_indicator": "icon",
        "git_status": true,
        "indent_size": 20,
        "auto_reveal_entries": true,
        "auto_fold_dirs": true,
        "bold_folder_labels": false,
        "sticky_scroll": true,
        "drag_and_drop": true,
        "sort_mode": "directories_first",
        "hide_root": false,
        "hide_hidden": false,
        "indent_guides": {
            "show": "always",
        },
    },

    "outline_panel": {
        "button": true,
        "default_width": 300,
        "dock": "left",
        "file_icons": true,
        "folder_indicator": "icon",
        "git_status": true,
        "indent_size": 20,
        "auto_reveal_entries": true,
        "auto_fold_dirs": true,
    },

    "toolbar": {
        "breadcrumbs": true,
        "quick_actions": false,
        "selections_menu": false,
        "agent_review": false,
        "code_actions": false,
    },

    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false,
        "show_tab_bar_buttons": true,
    },

    "tabs": {
        "close_position": "right",
        "file_icons": true,
        "git_status": true,
        "activate_on_close": "history",
        "show_close_button": "hover",
        "show_diagnostics": "errors",
    },

    "status_bar": {
        "active_language_button": true,
        "cursor_position_button": true,
        "line_endings_button": false,
    },

    "scrollbar": {
        "show": "auto",
        "cursors": true,
        "git_diff": true,
        "search_results": true,
        "selected_text": true,
        "selected_symbol": true,
        "diagnostics": "all",
    },

    "search": {
        "button": false,
        "whole_word": false,
        "case_sensitive": false,
        "include_ignored": false,
        "regex": false,
        "center_on_match": true,
        "search_on_type": true,
    },

    "file_finder": {
        "file_icons": true,
        "modal_max_width": "large",
        "include_ignored": "indexed",
    },

    "terminal": {
        "minimum_contrast": 0,
        "font_family": "LXGW WenKai Mono GB",
        "font_size": 16,
        "font_features": {
            "calt": false,
        },
        "line_height": "standard",
        "cursor_shape": "bar",
        "blinking": "on",
        "copy_on_select": false,
        "keep_selection_on_copy": true,
        "dock": "bottom",
        "starts_open": false,
        "button": true,
        "working_directory": "current_project_directory",
        "alternate_scroll": "off",
        "open_links_in_mouse_mode": true,
        "toolbar": {
            "breadcrumbs": false,
        },
    },

    "tasks": {
        "enabled": true,
        "prefer_lsp": false,
    },

    "lsp": {
        "clangd": {
            "binary": {
                "path": "/opt/homebrew/opt/llvm/bin/clangd",
            },
        },
    },

    "dap": {
        "CodeLLDB": {
            "binary": "/Applications/Xcode.app/Contents/Developer/usr/bin/lldb-dap",
        },
    },

    "session": {
        "restore_unsaved_buffers": true,
        "trust_all_worktrees": false,
    },

    "when_closing_with_no_tabs": "keep_window_open",

    "close_on_file_delete": true,

    "focus_follows_mouse": {
        "enabled": false,
    },

    "active_pane_modifiers": {
        "border_size": 1,
        "inactive_opacity": 0.92,
    },

    "title_bar": {
        "show_branch_status_icon": true,
        "show_branch_name": true,
        "show_worktree_name": true,
        "show_project_items": true,
        "show_onboarding_banner": false,
        "show_user_picture": false,
        "show_user_menu": true,
        "show_sign_in": false,
        "show_menus": false,
    },

    "auto_update": true,
}
