{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "HUANG One Light Glass",
  "author": "HUANG",
  "themes": [
    {
      "name": "HUANG One Light Glass",
      "appearance": "light",
      "style": {
        "background.appearance": "blurred",
        "background": "#00000000",
        "foreground": "#FFFFFF",

        "editor.background": "#FFFFFF00",
        "editor.foreground": "#FFFFFF",
        "editor.gutter.background": "#FFFFFF04",

        "panel.background": "#FFFFFF00",
        "toolbar.background": "#FFFFFF05",
        "title_bar.background": "#FFFFFF04",
        "tab_bar.background": "#FFFFFF04",
        "tab.active_background": "#FFFFFF12",
        "tab.inactive_background": "#FFFFFF02",
        "status_bar.background": "#FFFFFF06",

        "surface.background": "#FFFFFF00",
        "elevated_surface.background": "#FFFFFF00",
        "panel.overlay_background": "#FFFFFF00",

        "border": "#FFFFFF10",
        "border.variant": "#FFFFFF08",
        "border.focused": "#8ED8FF45",
        "border.selected": "#8ED8FF38",

        "scrollbar.track.background": "#FFFFFF02",
        "scrollbar.track.border": "#FFFFFF00",
        "scrollbar.thumb.background": "#FFFFFF20",
        "scrollbar.thumb.border": "#FFFFFF00",

        "element.hover": "#FFFFFF12",
        "element.selected": "#FFFFFF18",

        "editor.active_line.background": "#FFFFFF06",
        "editor.line_number": "#D6D9E0",
        "editor.active_line_number": "#FFFFFF",

        "editor.document_highlight.read_background": "#63BFFF18",
        "editor.document_highlight.write_background": "#63BFFF25",

        "text": "#FFFFFF",
        "text.muted": "#FFFFFF",
        "text.disabled": "#F2F4F7",
        "text.placeholder": "#F5F7FA",

        "icon": "#FFFFFF",
        "icon.muted": "#F5F7FA",

        "accent": "#63BFFF",
        "cursor": "#63BFFF",
        "editor.cursor": "#63BFFF",

        "error": "#FF173D",
        "warning": "#FFD60A",
        "success": "#30D158",
        "info": "#64D2FF",

        "terminal.background": "#FFFFFF00",
        "terminal.foreground": "#FFFFFF",
        "terminal.bright_foreground": "#FFFFFF",
        "terminal.dim_foreground": "#D7DCE4",

        "terminal.ansi.black": "#45475A",
        "terminal.ansi.red": "#F38BA8",
        "terminal.ansi.green": "#A6E3A1",
        "terminal.ansi.yellow": "#F9E2AF",
        "terminal.ansi.blue": "#89B4FA",
        "terminal.ansi.magenta": "#F5C2E7",
        "terminal.ansi.cyan": "#94E2D5",
        "terminal.ansi.white": "#A6ADC8",

        "terminal.ansi.bright_black": "#585B70",
        "terminal.ansi.bright_red": "#F37799",
        "terminal.ansi.bright_green": "#89D88B",
        "terminal.ansi.bright_yellow": "#EBD391",
        "terminal.ansi.bright_blue": "#74A8FC",
        "terminal.ansi.bright_magenta": "#F2AEDE",
        "terminal.ansi.bright_cyan": "#6BD7CA",
        "terminal.ansi.bright_white": "#FFFFFF",

        "syntax": {
          "attribute": {
            "color": "#F38BA8"
          },
          "boolean": {
            "color": "#F9E2AF"
          },
          "comment": {
            "color": "#666666",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "#666666",
            "font_style": "italic"
          },
          "constant": {
            "color": "#F9E2AF"
          },
          "constructor": {
            "color": "#94E2D5"
          },
          "embedded": {
            "color": "#FFFFFF"
          },
          "emphasis": {
            "color": "#89B4FA",
            "font_style": "italic"
          },
          "emphasis.strong": {
            "color": "#FFFFFF",
            "font_weight": 700
          },
          "enum": {
            "color": "#94E2D5"
          },
          "function": {
            "color": "#89B4FA"
          },
          "hint": {
            "color": "#6BD7CA"
          },
          "keyword": {
            "color": "#F5C2E7"
          },
          "label": {
            "color": "#6BD7CA"
          },
          "link_text": {
            "color": "#89B4FA",
            "font_style": "italic"
          },
          "link_uri": {
            "color": "#6BD7CA"
          },
          "namespace": {
            "color": "#94E2D5"
          },
          "number": {
            "color": "#F9E2AF"
          },
          "operator": {
            "color": "#94E2D5"
          },
          "preproc": {
            "color": "#F5C2E7"
          },
          "primary": {
            "color": "#FFFFFF"
          },
          "property": {
            "color": "#F38BA8"
          },
          "punctuation": {
            "color": "#A6ADC8"
          },
          "punctuation.bracket": {
            "color": "#A6ADC8"
          },
          "punctuation.delimiter": {
            "color": "#A6ADC8"
          },
          "punctuation.list_marker": {
            "color": "#F38BA8"
          },
          "punctuation.markup": {
            "color": "#F38BA8"
          },
          "punctuation.special": {
            "color": "#F37799"
          },
          "selector": {
            "color": "#A6E3A1"
          },
          "selector.pseudo": {
            "color": "#6BD7CA"
          },
          "string": {
            "color": "#A6E3A1"
          },
          "string.escape": {
            "color": "#EBD391"
          },
          "string.regex": {
            "color": "#EBD391"
          },
          "string.special": {
            "color": "#EBD391"
          },
          "string.symbol": {
            "color": "#EBD391"
          },
          "tag": {
            "color": "#94E2D5"
          },
          "text.literal": {
            "color": "#A6E3A1"
          },
          "title": {
            "color": "#F38BA8"
          },
          "type": {
            "color": "#94E2D5"
          },
          "variable": {
            "color": "#FFFFFF"
          },
          "variable.parameter": {
            "color": "#F37799"
          },
          "variable.special": {
            "color": "#EBD391"
          },
          "variant": {
            "color": "#74A8FC"
          }
        },

        "players": [
          {
            "cursor": "#63BFFF",
            "selection": "#63BFFF38"
          }
        ],

        "element.background": "#FFFFFF00",
        "element.active": "#FFFFFF18",
        "element.disabled": "#FFFFFF04",

        "ghost_element.background": "#FFFFFF00",
        "ghost_element.hover": "#FFFFFF00",
        "ghost_element.active": "#FFFFFF14",
        "ghost_element.selected": "#FFFFFF18",
        "ghost_element.disabled": "#FFFFFF00"
