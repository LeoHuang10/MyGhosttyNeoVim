" ============================================================
" MacVim GUI 透明毛玻璃與背景設置
" ============================================================

" 強制背景為深色
set background=dark

" 透明度：數值越小越透明，但透出的桌面顏色更多
set transparency=10

" 模糊半徑：拉到最高
set blurradius=50

" 使標題欄透明
set MMTitlebarAppearsTransparent
