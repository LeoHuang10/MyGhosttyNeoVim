# --- 字體排版 ---
#普通文本和亮色文本都改成純白
font-family = "LXGW WenKai Mono GB"
font-size = 12
adjust-cell-height = 2

# ---------- 主題 ----------
theme = Catppuccin Mocha
foreground = #FFFFFF
palette = 15=#FFFFFF

# --- 視窗與外觀 ---
background-opacity = 0.7
background-blur-radius = 60
macos-titlebar-style = transparent
window-padding-x = 10
window-padding-y = 8
window-save-state = always
window-theme = auto

# --- 光標 ---
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# --- 鼠標 ---
mouse-hide-while-typing = true
copy-on-select = clipboard

# --- 快速終端（含全局快捷鍵）---
keybind = global:cmd+backquote=toggle_quick_terminal
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# --- 安全 ---
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell 集成 ---
shell-integration = zsh

# --- Claude 專屬優化 ---
# initial-command = /opt/homebrew/bin/claude
initial-window = true
quit-after-last-window-closed = true
notify-on-command-finish = always

# --- 性能 ---
scrollback-limit = 25000000

# --- 分屏快捷鍵（完整功能）---
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+shift+f=toggle_split_zoom
keybind = cmd+shift+e=equalize_splits

# --- Vim 風格面板導航 ---
keybind = ctrl+h=goto_split:left
keybind = ctrl+j=goto_split:bottom
keybind = ctrl+k=goto_split:top
keybind = ctrl+l=goto_split:right

# --- 字體大小快速調節 ---
keybind = cmd+equal=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+0=reset_font_size

# --- 補充打磨 ---
# 將 Option 鍵映射為 Alt 鍵，避免在終端內輸出特殊字符，方便使用 Meta 快捷鍵
macos-option-as-alt = true      # Option 鍵映射為 Alt，方便 Meta 快捷鍵
# Ghostty 初次啟動時的視窗大小（若已有記憶的視窗狀態則以此為準）
window-initial-width = 120                                                  # 初始窗口寬度
window-initial-height = 40                                                  # 初始窗口高度
# 備用最大化當前分屏快捷鍵（功能與 cmd+shift+enter 相同）
keybind = cmd+shift+m=toggle_split_zoom                                     # 備用最大化分屏快捷鍵
